model Node {
  id         String   @id @default(uuid())
  status     Status   @default(NOT_STARTED)
  type       NodeType @default(BUILDING)
  goal       String
  blocker    String?
  depth      Int
  parentId   String?
  parentNode Node?    @relation("NodeToNode", fields: [parentId], references: [id])

  childNodes Node[]       @relation("NodeToNode")
  context    NodeContext?
  projectId  String?      @unique
  project    Project?     @relation(fields: [projectId], references: [id])

  createdAt             DateTime               @default(now())
  nodeTransitionHistory NodeTransitionHistory?
}

model NodeState {
  id               String            @id @default(uuid())
  goal             String
  blocker          String?
  status           Status
  type             NodeType
  depth            Int
  parentNodeId     String?
  childNodeIds     String[]
  nodeContextState NodeContextState? @relation()

  nodeTransitions   NodeTransition[] @relation("NodeTransitionFromState")
  nodeTransitionsTo NodeTransition[] @relation("NodeTransitionToState")
}

model NodeContextState {
  id             String    @id @default(uuid())
  rootNodeId     String
  pathFromRoot   String[]
  intentSummary  String
  constraints    String[]
  successSignals String[]
  nodeStateId    String    @unique
  nodeState      NodeState @relation(fields: [nodeStateId], references: [id])
}

model NodeContext {
  id             String   @id @default(uuid())
  nodeId         String   @unique
  node           Node     @relation(fields: [nodeId], references: [id])
  rootNodeId     String
  pathFromRoot   String[]
  intentSummary  String
  constraints    String[]
  successSignals String[]

  createdAt DateTime @default(now())
}

model NodeTransition {
  id                      String                @id @default(uuid())
  reason                  String
  triggeredBy             String
  nodeId                  String
  nodeTransitionHistoryId String
  nodeTransitionHistory   NodeTransitionHistory @relation(fields: [nodeTransitionHistoryId], references: [id], name: "NodeTransitionHistoryToNodeTransition")
  fromStateId             String?
  toStateId               String?
  fromState               NodeState?            @relation("NodeTransitionFromState", fields: [fromStateId], references: [id])
  toState                 NodeState?            @relation("NodeTransitionToState", fields: [toStateId], references: [id])
  timestamp               DateTime              @default(now())
}

model NodeTransitionHistory {
  id          String           @id @default(uuid())
  nodeId      String           @unique
  node        Node             @relation(fields: [nodeId], references: [id])
  transitions NodeTransition[] @relation("NodeTransitionHistoryToNodeTransition")
}

enum NodeType {
  BUILDING
  CONCEPT
}

enum Status {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}
